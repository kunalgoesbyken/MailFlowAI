# Google OAuth Configuration
# Get these from https://console.cloud.google.com/
NEXT_PUBLIC_GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GMAIL_REDIRECT_URI=https://ai-mail-app-pearl.vercel.app/auth/callback

# Google OAuth client secret (server-side only, never prefix with NEXT_PUBLIC_)
GMAIL_CLIENT_SECRET=your-client-secret

# Groq AI API Key (server-side only)
# Get your free API key from https://console.groq.com
GROQ_API_KEY=
